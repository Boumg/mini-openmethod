{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "llvm",
      "displayName": "LLVM sous Windows — Release",
      "description": "Clang installe dans Program Files/LLVM, avec Ninja et les bibliotheques Windows de Visual Studio.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-llvm",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "$penv{ProgramFiles}/LLVM/bin/clang++.exe",
        "CMAKE_TOOLCHAIN_FILE": "$penv{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "CMAKE_BUILD_TYPE": "Release",
        "MINI_OPENMETHOD_REFLEXION": "AUTO",
        "MINI_OPENMETHOD_TESTS": "ON",
        "MINI_OPENMETHOD_EXEMPLES": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "llvm",
      "configurePreset": "llvm",
      "jobs": 2
    }
  ],
  "testPresets": [
    {
      "name": "llvm",
      "configurePreset": "llvm",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 2,
        "noTestsAction": "error"
      }
    }
  ]
}

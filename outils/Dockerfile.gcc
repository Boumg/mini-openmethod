# Chaine GCC pour valider et comparer les deux implementations.
FROM gcc:16.2
RUN apt-get update -qq \
    && apt-get install -y -qq cmake ninja-build time git curl zip unzip tar pkg-config \
    && rm -rf /var/lib/apt/lists/*
ARG VCPKG_REVISION
RUN test -n "${VCPKG_REVISION}" \
    && git init /opt/vcpkg \
    && git -C /opt/vcpkg remote add origin https://github.com/microsoft/vcpkg.git \
    && git -C /opt/vcpkg fetch --depth 1 origin "${VCPKG_REVISION}" \
    && git -C /opt/vcpkg checkout --detach FETCH_HEAD \
    && /opt/vcpkg/bootstrap-vcpkg.sh -disableMetrics
ENV VCPKG_ROOT=/opt/vcpkg
WORKDIR /sources

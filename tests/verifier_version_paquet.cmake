# Exerce le fichier distribue : aucune compilation 32 bits n'est simulee ici.
function(verifier_version version taille_pointeur compatible)
    set(PACKAGE_FIND_VERSION "${version}")
    string(REPLACE "." ";" composantes "${version}")
    list(GET composantes 0 PACKAGE_FIND_VERSION_MAJOR)
    list(GET composantes 1 PACKAGE_FIND_VERSION_MINOR)
    list(GET composantes 2 PACKAGE_FIND_VERSION_PATCH)
    set(PACKAGE_FIND_VERSION_COUNT 3)
    set(CMAKE_SIZEOF_VOID_P "${taille_pointeur}")
    include("${FICHIER_VERSION}")
    if(PACKAGE_VERSION_UNSUITABLE)
        message(FATAL_ERROR "Le paquet d'en-tetes refuse une architecture : ${taille_pointeur} octets")
    endif()
    if((compatible AND NOT PACKAGE_VERSION_COMPATIBLE)
       OR (NOT compatible AND PACKAGE_VERSION_COMPATIBLE))
        message(FATAL_ERROR "Compatibilite inattendue pour ${version} avec ${VERSION_PROJET}")
    endif()
endfunction()

string(REPLACE "." ";" composantes "${VERSION_PROJET}")
list(GET composantes 0 majeure)
list(GET composantes 1 mineure)
list(GET composantes 2 correctif)
math(EXPR mineure_suivante "${mineure} + 1")
math(EXPR correctif_suivant "${correctif} + 1")
foreach(taille IN ITEMS 4 8)
    verifier_version("${VERSION_PROJET}" "${taille}" TRUE)
    verifier_version("${majeure}.${mineure}.0" "${taille}" TRUE)
    verifier_version("${majeure}.${mineure}.${correctif_suivant}" "${taille}" FALSE)
    verifier_version("${majeure}.${mineure_suivante}.0" "${taille}" FALSE)
    if(mineure GREATER 0)
        math(EXPR mineure_precedente "${mineure} - 1")
        verifier_version("${majeure}.${mineure_precedente}.0" "${taille}" FALSE)
    endif()
endforeach()
